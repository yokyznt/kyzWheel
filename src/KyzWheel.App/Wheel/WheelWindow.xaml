<Window
    x:Class="KyzWheel.App.Wheel.WheelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True" IsTabStop="True" RequestedTheme="Dark">
        <Canvas x:Name="Stage" Width="360" Height="360">
            <Ellipse x:Name="Glow" Width="360" Height="360" IsHitTestVisible="False" Visibility="Collapsed" />
            <Ellipse x:Name="Disc" Canvas.Left="2" Canvas.Top="2" Width="356" Height="356" IsHitTestVisible="False" />
            <Canvas x:Name="Layer" Width="360" Height="360" />
            <Ellipse x:Name="Rim" Canvas.Left="2.5" Canvas.Top="2.5" Width="355" Height="355" StrokeThickness="1" IsHitTestVisible="False">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#4DFFFFFF" Offset="0" />
                        <GradientStop Color="#0AFFFFFF" Offset="0.6" />
                        <GradientStop Color="#1AFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>
            <Ellipse x:Name="Groove" Canvas.Left="110" Canvas.Top="110" Width="140" Height="140" StrokeThickness="1.5" Fill="#26000000" Stroke="#1FFFFFFF" IsHitTestVisible="False" />
            <Canvas x:Name="Pointer" Width="360" Height="360" Opacity="0" IsHitTestVisible="False">
                <Path x:Name="PointerArc" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 162.6,112.2 A 70,70 0 0 1 197.4,112.2" />
                <Ellipse x:Name="PointerDot" Width="0" Height="0" />
            </Canvas>
            <Ellipse x:Name="HubSheen" Canvas.Left="122" Canvas.Top="122" Width="116" Height="116" IsHitTestVisible="False" Canvas.ZIndex="1" />
            <Ellipse x:Name="Hub" Canvas.Left="122" Canvas.Top="122" Width="116" Height="116" IsHitTestVisible="False" />
            <Grid x:Name="HubText" Canvas.ZIndex="2" Canvas.Left="122" Canvas.Top="122" Width="116" Height="116" IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5">
                    <Grid x:Name="HubThumbHost" Width="40" Height="40" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Border CornerRadius="10" Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" />
                        <Image x:Name="HubThumb" Width="34" Height="34" Stretch="Uniform" />
                        <Border x:Name="HubCount" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Background="#F2FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0" Visibility="Collapsed">
                            <TextBlock x:Name="HubCountText" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF0B0B10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <Border x:Name="HubPill" CornerRadius="15" Height="30" MinWidth="64" MaxWidth="104" Padding="12,0" HorizontalAlignment="Center" Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="HubTitle" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#F5FFFFFF" FontFamily="ms-appx:///Assets/Fonts/Outfit.ttf#Outfit" FontSize="12" FontWeight="SemiBold" CharacterSpacing="30" />
                    </Border>
                    <TextBlock x:Name="HubSub" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100" FontFamily="ms-appx:///Assets/Fonts/Outfit.ttf#Outfit" Foreground="#66FFFFFF" FontSize="8.5" CharacterSpacing="60" />
                    <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5" />
                </StackPanel>
            </Grid>
        </Canvas>
    </Grid>
</Window>
