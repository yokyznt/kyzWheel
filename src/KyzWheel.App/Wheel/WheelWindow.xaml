<Window
    x:Class="KyzWheel.App.Wheel.WheelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True" IsTabStop="True" RequestedTheme="Dark">
        <Canvas x:Name="Stage" Width="360" Height="360">
            <Ellipse x:Name="Glow" Width="360" Height="360" IsHitTestVisible="False" Visibility="Collapsed" />
            <Ellipse x:Name="Disc" Canvas.Left="2" Canvas.Top="2" Width="356" Height="356" IsHitTestVisible="False" />
            <Canvas x:Name="Layer" Width="360" Height="360" />
            <Ellipse x:Name="Rim" Canvas.Left="2.5" Canvas.Top="2.5" Width="355" Height="355" StrokeThickness="1" IsHitTestVisible="False">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#4DFFFFFF" Offset="0" />
                        <GradientStop Color="#0AFFFFFF" Offset="0.6" />
                        <GradientStop Color="#1AFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>
            <Ellipse x:Name="Groove" Canvas.Left="110" Canvas.Top="110" Width="140" Height="140" StrokeThickness="1.5" Fill="#14000000" Stroke="#26FFFFFF" IsHitTestVisible="False" />
            <Canvas x:Name="Pointer" Width="360" Height="360" Opacity="0" IsHitTestVisible="False">
                <Path x:Name="PointerArc" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse x:Name="PointerDot" Width="0" Height="0" />
            </Canvas>
            <Ellipse x:Name="HubSheen" Canvas.Left="122" Canvas.Top="122" Width="116" Height="116" IsHitTestVisible="False" Canvas.ZIndex="1" />
            <Ellipse x:Name="Hub" Canvas.Left="122" Canvas.Top="122" Width="116" Height="116" IsHitTestVisible="False" />
            <Ellipse x:Name="HubPreview" Canvas.ZIndex="2" Canvas.Left="124" Canvas.Top="124" Width="112" Height="112" Stroke="#40FFFFFF" StrokeThickness="1" IsHitTestVisible="False" Visibility="Collapsed">
                <Ellipse.Fill>
                    <ImageBrush x:Name="HubPreviewBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                </Ellipse.Fill>
            </Ellipse>
            <Grid x:Name="HubText" Canvas.ZIndex="3" Canvas.Left="122" Canvas.Top="122" Width="116" Height="116" IsHitTestVisible="False">
                <Image x:Name="HubThumb" Width="60" Height="60" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <Border x:Name="HubCount" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" Background="#F2FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed">
                    <TextBlock x:Name="HubCountText" FontFamily="ms-appx:///Assets/Fonts/Outfit.ttf#Outfit" FontSize="11" FontWeight="SemiBold" Foreground="#FF0B0B10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel x:Name="HubLabels" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5">
                    <Border x:Name="HubPill" CornerRadius="15" Height="30" MinWidth="64" MaxWidth="104" Padding="12,0" HorizontalAlignment="Center" Background="#33FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="HubTitle" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#F5FFFFFF" FontFamily="ms-appx:///Assets/Fonts/Outfit.ttf#Outfit" FontSize="13.5" FontWeight="Bold" CharacterSpacing="20" />
                    </Border>
                    <TextBlock x:Name="HubSub" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100" FontFamily="ms-appx:///Assets/Fonts/Outfit.ttf#Outfit" Foreground="#B3FFFFFF" FontSize="9.5" FontWeight="SemiBold" CharacterSpacing="50" />
                </StackPanel>
                <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Spacing="5" />
                <StackPanel x:Name="HintTop" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9,0,0" Spacing="3" Opacity="0.75">
                    <FontIcon Glyph="&#xE962;" FontSize="10.5" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="White" />
                    <FontIcon x:Name="HintTopIcon" Glyph="&#xE70F;" FontSize="11.5" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="White" />
                </StackPanel>
                <StackPanel x:Name="HintBottom" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9" Spacing="3" Opacity="0.75">
                    <FontIcon Glyph="&#xE962;" FontSize="10.5" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="White" />
                    <FontIcon Glyph="&#xE711;" FontSize="10.5" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Foreground="White" />
                </StackPanel>
            </Grid>
        </Canvas>
    </Grid>
</Window>
