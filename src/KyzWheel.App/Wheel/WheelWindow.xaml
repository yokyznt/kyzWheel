<Window
    x:Class="KyzWheel.App.Wheel.WheelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True" IsTabStop="True" RequestedTheme="Dark">
        <Canvas x:Name="Stage" Width="360" Height="360">
            <Ellipse x:Name="Glow" Width="360" Height="360" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#99000000" Offset="0.84" />
                        <GradientStop Color="#33000000" Offset="0.92" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Canvas x:Name="Layer" Width="360" Height="360" />
            <Canvas x:Name="Pointer" Width="360" Height="360" Opacity="0" IsHitTestVisible="False">
                <Path x:Name="PointerArc" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 160.4,68.8 A 113,113 0 0 1 199.6,68.8" />
                <Ellipse x:Name="PointerDot" Canvas.Left="176" Canvas.Top="58" Width="8" Height="8" />
            </Canvas>
            <Ellipse x:Name="Rim" Canvas.Left="20" Canvas.Top="20" Width="320" Height="320" StrokeThickness="1" IsHitTestVisible="False">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#40FFFFFF" Offset="0" />
                        <GradientStop Color="#08FFFFFF" Offset="0.6" />
                        <GradientStop Color="#14FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>
            <Ellipse x:Name="HubSheen" Canvas.Left="124" Canvas.Top="124" Width="112" Height="112" IsHitTestVisible="False" Canvas.ZIndex="1" />
            <Ellipse x:Name="Hub" Canvas.Left="124" Canvas.Top="124" Width="112" Height="112" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FF17171E" Offset="0" />
                        <GradientStop Color="#FF09090D" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#38FFFFFF" Offset="0" />
                        <GradientStop Color="#0AFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>
            <StackPanel x:Name="HubText" Canvas.ZIndex="2" Canvas.Left="124" Canvas.Top="124" Width="112" Height="112" IsHitTestVisible="False" Padding="10,0">
                <Grid x:Name="HubThumbHost" Width="44" Height="44" Margin="0,12,0,4" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Border CornerRadius="12" Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" />
                    <Image x:Name="HubThumb" Width="38" Height="38" Stretch="Uniform" />
                    <Border x:Name="HubCount" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Background="#F2FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0" Visibility="Collapsed">
                        <TextBlock x:Name="HubCountText" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF0B0B10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock x:Name="HubTitle" Margin="0,38,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#F5FFFFFF" FontFamily="ms-appx:///Assets/Fonts/Outfit.ttf#Outfit" FontSize="14" FontWeight="SemiBold" CharacterSpacing="-6" />
                <TextBlock x:Name="HubSub" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="ms-appx:///Assets/Fonts/Outfit.ttf#Outfit" Foreground="#73FFFFFF" FontSize="9" Margin="0,2,0,0" CharacterSpacing="60" />
                <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5" Margin="0,9,0,0" />
            </StackPanel>
        </Canvas>
    </Grid>
</Window>
