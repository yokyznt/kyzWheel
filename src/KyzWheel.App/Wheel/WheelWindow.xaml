<Window
    x:Class="KyzWheel.App.Wheel.WheelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent">
        <Ellipse x:Name="Disc" Width="360" Height="360" Fill="#D90B0B10" Stroke="#33FFFFFF" StrokeThickness="1" />
        <TextBlock Text="kyzWheel" Foreground="#E6FFFFFF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
